# Create individual solver archives from existing binaries.
# Called by the ampl-module target and package-solvers.sh.
cmake_minimum_required(VERSION 3.10)

foreach (var PLATFORM BINDIR OUTDIR SOURCE_DIR VERSIONS_FILE)
  if (NOT DEFINED ${var})
    message(FATAL_ERROR "package-ampl.cmake: -D${var}=... is required")
  endif ()
  if (NOT var STREQUAL "PLATFORM")
    get_filename_component(${var} "${${var}}" ABSOLUTE)
  endif ()
endforeach ()
if (PLATFORM MATCHES "^macos")
  set(PLATFORM macos64)
endif ()
if (NOT DEFINED SOLVERS)
  set(SOLVERS bonmin,couenne,ipopt)
endif ()
string(REPLACE "," ";" SOLVERS "${SOLVERS}")
# Release versions come from changelogs, never from the build date.
function(read_package_version changelog output)
  file(READ "${changelog}" contents)
  if (NOT contents MATCHES "## ([0-9]+)[\r\n]")
    message(FATAL_ERROR "Missing dated release heading in ${changelog}")
  endif ()
  set(version "${CMAKE_MATCH_1}")
  string(LENGTH "${version}" length)
  if (NOT length EQUAL 8)
    message(FATAL_ERROR "Release heading must use YYYYMMDD in ${changelog}")
  endif ()
  set(${output} "${version}" PARENT_SCOPE)
endfunction()

set(exe "")
set(archive_extension "tar.gz")
if (PLATFORM MATCHES "^mswin")
  set(exe ".exe")
  set(archive_extension "zip")
endif ()

set(package_prefix "")
if (SIGNING_IDENTITY)
  if (NOT CMAKE_HOST_APPLE OR NOT PLATFORM MATCHES "^macos")
    message(FATAL_ERROR "Code signing requires macOS binaries on a macOS host")
  endif ()
  if (SIGNING_IDENTITY STREQUAL "-")
    message(FATAL_ERROR "Signed release packages require a certificate identity")
  endif ()
  find_program(CODESIGN_EXECUTABLE codesign)
  if (NOT CODESIGN_EXECUTABLE)
    message(FATAL_ERROR "Cannot find codesign")
  endif ()
  set(package_prefix "signed-")
  set(signing_options --entitlements "${SOURCE_DIR}/package/entitlements.plist"
    --verbose=4 --force --sign "${SIGNING_IDENTITY}" --options=runtime --timestamp)
  if (SIGNING_KEYCHAIN)
    list(APPEND signing_options --keychain "${SIGNING_KEYCHAIN}")
  endif ()
endif ()

# Validate all inputs before writing any release archives.
set(required "${VERSIONS_FILE}" "${SOURCE_DIR}/Cbc/Cbc/LICENSE")
foreach (solver ${SOLVERS})
  if (NOT solver MATCHES "^(cbc|bonmin|couenne|ipopt)$")
    message(FATAL_ERROR "Unsupported solver package: ${solver}")
  endif ()
  list(APPEND required "${BINDIR}/${solver}${exe}"
    "${SOURCE_DIR}/docs/README.${solver}.txt")
  if (NOT solver STREQUAL "cbc")
    list(APPEND required "${SOURCE_DIR}/docs/CHANGES.${solver}.md")
  endif ()
  if (exe AND NOT solver STREQUAL "cbc")
    list(APPEND required "${BINDIR}/libipoptfort.dll")
  endif ()
endforeach ()
foreach (path ${required})
  if (NOT EXISTS "${path}")
    message(FATAL_ERROR "Missing ${path}")
  endif ()
endforeach ()

file(MAKE_DIRECTORY "${OUTDIR}")
foreach (solver ${SOLVERS})
  set(stage "${OUTDIR}/.stage-${package_prefix}${solver}")
  file(REMOVE_RECURSE "${stage}")
  file(MAKE_DIRECTORY "${stage}/docs")
  # Preserve executable permissions; distribute documentation as readable files.
  file(COPY "${BINDIR}/${solver}${exe}" DESTINATION "${stage}")
  if (exe AND NOT solver STREQUAL "cbc")
    file(COPY "${BINDIR}/libipoptfort.dll" DESTINATION "${stage}")
  endif ()
  file(COPY "${SOURCE_DIR}/docs/README.${solver}.txt" DESTINATION "${stage}/docs"
    FILE_PERMISSIONS OWNER_READ OWNER_WRITE GROUP_READ WORLD_READ)
  if (EXISTS "${SOURCE_DIR}/docs/CHANGES.${solver}.md")
    file(COPY "${SOURCE_DIR}/docs/CHANGES.${solver}.md" DESTINATION "${stage}/docs"
      FILE_PERMISSIONS OWNER_READ OWNER_WRITE GROUP_READ WORLD_READ)
  endif ()
  configure_file("${SOURCE_DIR}/Cbc/Cbc/LICENSE" "${stage}/docs/coin-license.txt" COPYONLY)
  configure_file("${VERSIONS_FILE}" "${stage}/docs/coin-versions.txt" COPYONLY)

  if (SIGNING_IDENTITY)
    # Sign only the staged copy, preserving the original build and packages.
    execute_process(COMMAND /usr/bin/xattr -c "${stage}/${solver}"
      RESULT_VARIABLE result)
    if (NOT result EQUAL 0)
      message(FATAL_ERROR "Cannot clear extended attributes on ${solver}")
    endif ()
    execute_process(
      COMMAND "${CODESIGN_EXECUTABLE}" ${signing_options}
        --identifier "com.ampl.solvers.${solver}" "${stage}/${solver}"
      RESULT_VARIABLE result)
    if (NOT result EQUAL 0)
      message(FATAL_ERROR "Code signing failed for ${solver}")
    endif ()
    execute_process(
      COMMAND "${CODESIGN_EXECUTABLE}" --verify --strict --verbose=2 "${stage}/${solver}"
      RESULT_VARIABLE result)
    if (NOT result EQUAL 0)
      message(FATAL_ERROR "Code signature verification failed for ${solver}")
    endif ()
  endif ()

  if (EXISTS "${SOURCE_DIR}/docs/CHANGES.${solver}.md")
    read_package_version("${SOURCE_DIR}/docs/CHANGES.${solver}.md" package_version)
  else ()
    # Optional Cbc packages use the newest documented solver release date.
    set(package_version "")
    file(GLOB changelogs "${SOURCE_DIR}/docs/CHANGES.*.md")
    foreach (changelog ${changelogs})
      read_package_version("${changelog}" version)
      if (version STRGREATER package_version)
        set(package_version "${version}")
      endif ()
    endforeach ()
    if (NOT package_version)
      message(FATAL_ERROR "No solver changelog release versions found")
    endif ()
  endif ()
  set(archive "${OUTDIR}/${package_prefix}solvers-${solver}.${PLATFORM}.${package_version}.${archive_extension}")
  if (archive_extension STREQUAL "zip")
    set(archive_options cf "${archive}" --format=zip)
  else ()
    set(archive_options czf "${archive}" --format=gnutar)
  endif ()
  execute_process(
    COMMAND ${CMAKE_COMMAND} -E env COPYFILE_DISABLE=1
      ${CMAKE_COMMAND} -E tar ${archive_options} .
    WORKING_DIRECTORY "${stage}"
    RESULT_VARIABLE result)
  file(REMOVE_RECURSE "${stage}")
  if (NOT result EQUAL 0)
    message(FATAL_ERROR "Failed to create ${archive}")
  endif ()
  message(STATUS "Created ${archive}")
endforeach ()
