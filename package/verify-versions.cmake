# Check the versions compiled into releases against the latest changelog entries.
cmake_minimum_required(VERSION 3.10)
if (NOT DEFINED RELEASE_SOURCE_DIR)
  get_filename_component(RELEASE_SOURCE_DIR "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
endif ()

function(check_documented_version name source pattern)
  file(READ "${RELEASE_SOURCE_DIR}/${source}" contents)
  if (NOT contents MATCHES "${pattern}")
    message(FATAL_ERROR "Cannot read ${name} version from ${source}")
  endif ()
  set(actual "${CMAKE_MATCH_1}")
  foreach (solver ${ARGN})
    file(READ "${RELEASE_SOURCE_DIR}/docs/CHANGES.${solver}.md" changelog)
    if (NOT changelog MATCHES "## [0-9]+[\r\n]+([^#]*)")
      message(FATAL_ERROR "Cannot find latest changelog entry for ${solver}")
    endif ()
    set(latest "${CMAKE_MATCH_1}")
    if (NOT latest MATCHES "${name}[^0-9]*([0-9]+(\\.[0-9]+)*)")
      message(FATAL_ERROR "Latest ${solver} changelog does not document ${name}")
    endif ()
    set(documented "${CMAKE_MATCH_1}")
    if (NOT actual STREQUAL documented)
      message(FATAL_ERROR
        "${name} source version ${actual} differs from ${solver} changelog version ${documented}")
    endif ()
  endforeach ()
  message(STATUS "Verified ${name} ${actual} against release changelogs")
endfunction()

set(ac_version "AC_INIT\\(\\[[^]]+\\],\\[([0-9.]+)\\]")
check_documented_version(Cbc Cbc/Cbc/configure.ac "${ac_version}" bonmin couenne)
check_documented_version(Bonmin Bonmin/Bonmin/configure.ac "${ac_version}" bonmin couenne)
check_documented_version(Bonmin Bonmin/configure.ac "${ac_version}" bonmin couenne)
check_documented_version(Couenne Couenne/Couenne/configure.ac "${ac_version}" couenne)
check_documented_version(Couenne Couenne/configure.ac "${ac_version}" couenne)
check_documented_version(Ipopt Ipopt/Ipopt/configure.ac "${ac_version}" ipopt bonmin couenne)
check_documented_version(Ipopt Ipopt/configure.ac "${ac_version}" ipopt bonmin couenne)
check_documented_version(MUMPS ThirdParty/Mumps/MUMPS/VERSION "MUMPS ([0-9.]+)" ipopt)
check_documented_version(ASL ThirdParty/asl/src/solvers/asldate.c
  "ASLdate_ASL = ([0-9]+)" ipopt bonmin couenne)
